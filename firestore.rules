rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function myUid() { return request.auth.uid; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(myUid())).data; }
    function myRole() { return myProfile().role; }
    function isTeacher() { return isSignedIn() && myRole() == "teacher"; }
    function isStudent() { return isSignedIn() && myRole() == "student"; }
    function myClass() { return myProfile().classId; }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if isSignedIn() && (uid == myUid() || isTeacher());
      allow create: if isSignedIn() && uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ["student","teacher"];
      allow update: if isSignedIn() && uid == myUid()
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }

    // ---------- classes ----------
    match /classes/{id} {
      allow read: if isSignedIn();
      allow write: if isTeacher();
    }

    // ---------- tests (question text + options are public to the class; the
    // correct-answer index lives in a separate teacher-only collection) ----------
    match /tests/{id} {
      allow read: if isSignedIn() && (isTeacher() || (isStudent() && resource.data.classId == myClass() && resource.data.published == true));
      allow write: if isTeacher();
    }

    // ---------- answerKeys (teacher-only, never readable by students) ----------
    match /answerKeys/{testId} {
      allow read, write: if isTeacher();
    }

    // ---------- attempts ----------
    match /attempts/{id} {
      // Full read of your own attempt (including in-progress); teachers can
      // read everything; classmates can read each other's *submitted*
      // attempts only (needed to build the leaderboard client-side, since
      // this app has no backend/Cloud Functions to aggregate scores
      // privately — an in_progress attempt stays private to its owner).
      allow read: if isSignedIn() && (
        isTeacher()
        || resource.data.uid == myUid()
        || (isStudent() && resource.data.classId == myClass() && resource.data.status == "submitted")
      );
      allow create: if isStudent()
        && request.resource.data.uid == myUid()
        && request.resource.data.classId == myClass()
        && request.resource.data.status == "in_progress"
        && request.resource.data.score == null;
      allow update: if isSignedIn() && (
        // Student can update their own attempt, but never the graded fields —
        // those are teacher-only, set during grading.
        (resource.data.uid == myUid()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.testId == resource.data.testId
          && request.resource.data.classId == resource.data.classId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score','total','percentage','gradedAt','topicStats','review']))
        || isTeacher()
      );
      allow delete: if false;
    }
  }
}
