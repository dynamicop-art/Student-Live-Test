rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isTeacher(){ return signedIn() && request.auth.token.email == "arpanalaps64@gmail.com"; }
    function myProfile(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function myClass(){ return myProfile().data.classId; }

    match /invites/{email} {
      allow read: if isTeacher() || (signedIn() && request.auth.token.email == email);
      allow create, update, delete: if isTeacher();
    }

    match /users/{uid} {
      allow read: if isTeacher() || (signedIn() && uid == request.auth.uid) || (signedIn() && get(/databases/$(database)/documents/users/$(uid)).data.classId == myClass());
      allow create: if signedIn() && uid == request.auth.uid
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == "student";
      // Students may only ever touch their OWN doc, and only these three
      // self-service fields. Every other field (name/class/role/etc) stays teacher-only.
      // Content is also validated server-side so the client's 150KB/format checks
      // can't be bypassed by writing to Firestore directly (e.g. via devtools).
      function validAvatar(){
        return !('avatarData' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.avatarData is string
              && request.resource.data.avatarData.size() < 210000
              && (request.resource.data.avatarData == ""
                  || request.resource.data.avatarData.matches('^data:image/.*')));
      }
      function validBookmarks(){
        return !('bookmarks' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.bookmarks is list && request.resource.data.bookmarks.size() < 500);
      }
      function validStreak(){
        return !('streak' in request.resource.data.diff(resource.data).affectedKeys())
          || (request.resource.data.streak is map
              && request.resource.data.streak.count is int
              && request.resource.data.streak.count >= 0
              && request.resource.data.streak.count < 100000);
      }
      allow update: if isTeacher() || (
        signedIn() && uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarData','bookmarks','streak'])
        && validAvatar() && validBookmarks() && validStreak()
      );
      allow delete: if isTeacher();
    }

    match /subjects/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.classId == myClass());
      allow write: if isTeacher();
    }

    match /notes/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.classId == myClass());
      allow write: if isTeacher();
    }

    match /tests/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.classId == myClass() && resource.data.published == true);
      allow write: if isTeacher();
    }

    match /answerKeys/{id} {
      allow read, write: if isTeacher();
    }

    match /attempts/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.classId == myClass();

      // Owner can always read their own attempt. Classmates can read each
      // other's SUBMITTED attempts too (name + score only, used for the
      // in-class leaderboard) once grading is done.
      allow read: if isTeacher()
        || (signedIn() && resource.data.uid == request.auth.uid)
        || (signedIn() && resource.data.classId == myClass() && resource.data.status == "submitted");

      allow update: if isTeacher() || (
        signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.testId == resource.data.testId
        && request.resource.data.classId == resource.data.classId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['score','total','percentage','gradedAt','topicStats','review'])
      );

      allow delete: if isTeacher();
    }

    match /announcements/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.classId == myClass());
      allow write: if isTeacher();
    }

    match /assignments/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.classId == myClass());
      allow write: if isTeacher();
    }

    // Doc id convention: {assignmentId}_{uid} so a student can only ever
    // create/update the completion record that matches their own uid.
    match /assignmentStatus/{id} {
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.classId == myClass()
        && id == (request.resource.data.assignmentId + '_' + request.auth.uid);
      allow delete: if isTeacher();
    }

    match /doubts/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.classId == myClass()
        && request.resource.data.status == "open"
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() < 3000;
      allow read: if isTeacher() || (signedIn() && resource.data.uid == request.auth.uid);
      // Only the teacher may answer / change status.
      allow update: if isTeacher();
      allow delete: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
