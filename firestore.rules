rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() {
      return signedIn() && request.auth.token.email == "YOUR_TEACHER_EMAIL@gmail.com";
    }

    match /attempts/{attemptId} {
      allow create: if signedIn()
                    && request.resource.data.studentUid == request.auth.uid
                    && request.resource.data.testId == "chem_unit1_test1";

      allow read: if isTeacher()
                  || (signedIn() && resource.data.studentUid == request.auth.uid);

      allow update: if isTeacher()
                    || (signedIn()
                        && resource.data.studentUid == request.auth.uid
                        && request.resource.data.studentUid == resource.data.studentUid
                        && request.resource.data.testId == resource.data.testId);

      allow delete: if isTeacher();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}